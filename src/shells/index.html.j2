{#- index switcher: blockchain / platform tabs only -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ person.name }} — Resume</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root{
    --bg:#0b0d12; --panel:#13161e; --line:#252a36; --ink:#e8e9ed; --dim:#7b8294;
    --teal:#0f766e; --cyan:#22d3ee; --purple:#a855f7;
    --sans:'Inter','Helvetica Neue',system-ui,sans-serif;
    --mono:ui-monospace,'SF Mono','JetBrains Mono',monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:13.5px}
  body{display:grid;grid-template-rows:auto 1fr}

  header{display:flex;align-items:center;gap:14px;padding:10px 18px;background:var(--panel);border-bottom:1px solid var(--line);flex-wrap:wrap}
  .brand{display:flex;align-items:baseline;gap:8px}
  .brand .name{font-weight:700;letter-spacing:-0.3px;font-size:15px}
  .brand .lbl{color:var(--dim);font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase}

  nav{display:flex;gap:6px;flex-wrap:wrap}
  nav button{
    appearance:none;background:transparent;border:1px solid var(--line);color:var(--ink);
    padding:6px 14px;border-radius:999px;font-family:var(--sans);font-size:12.5px;font-weight:500;
    cursor:pointer;transition:all .15s;
  }
  nav button:hover{border-color:var(--cyan);color:var(--cyan)}
  nav button.active{border-color:transparent;color:#fff;font-weight:600;background:linear-gradient(135deg,var(--teal),var(--cyan))}

  .actions{margin-left:auto;display:flex;gap:8px;align-items:center}
  .actions a{color:var(--dim);text-decoration:none;font-family:var(--mono);font-size:11.5px;padding:6px 12px;border:1px solid var(--line);border-radius:999px;transition:all .15s;white-space:nowrap}
  .actions a:hover{color:var(--ink);border-color:var(--ink)}

  main{position:relative;background:#fff}
  iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:none}
  iframe.active{display:block}

  @media (max-width: 520px){
    .brand .lbl{display:none}
    nav button{padding:5px 10px;font-size:11.5px}
  }
</style>
</head>
<body>

<header>
  <div class="brand">
    <span class="name">{{ person.name }}</span>
    <span class="lbl">resume/</span>
  </div>
  <nav class="tabs">
    {% for item in targets %}<button data-src="{{ item.out }}?v={{ cache_bust }}"{% if loop.first %} class="active"{% endif %}>{{ item.label }}</button>
    {% endfor %}
  </nav>
  <div class="actions">
    <a id="open-tab" href="{{ default_target }}" target="_blank" rel="noopener">↗ open in new tab</a>
    {% for item in targets %}<a href="pdf/{{ item.out | replace('.html','.pdf') }}" target="_blank">↓ {{ item.label }} PDF</a>{% endfor %}
  </div>
</header>

<main>
  {% for item in targets %}<iframe id="f-{{ item.out | replace('.html','') }}"{% if loop.first %} src="{{ item.out }}?v={{ cache_bust }}" class="active"{% else %} data-src="{{ item.out }}?v={{ cache_bust }}"{% endif %} title="{{ item.label }}"></iframe>
  {% endfor %}
</main>

<script>
  const allTabs = document.querySelectorAll('nav.tabs button');
  const frames = document.querySelectorAll('main iframe');
  const openTab = document.getElementById('open-tab');

  function activate(src) {
    const bareKey = src.replace(/\?.*$/, '').replace('.html', '');
    allTabs.forEach(b => b.classList.toggle('active', b.dataset.src === src));
    frames.forEach(fr => {
      const want = (fr.id === 'f-' + bareKey);
      if (want && !fr.src) fr.src = fr.dataset.src || src;
      fr.classList.toggle('active', want);
    });
    openTab.href = src;
    history.replaceState(null, '', '#' + bareKey);
  }

  allTabs.forEach(b => b.addEventListener('click', () => activate(b.dataset.src)));

  window.addEventListener('keydown', e => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const i = parseInt(e.key, 10);
    if (i >= 1 && i <= allTabs.length) {
      e.preventDefault();
      activate(allTabs[i-1].dataset.src);
    }
  });

  const hash = location.hash.replace('#','');
  if (hash) {
    const match = Array.from(allTabs).find(b => b.dataset.src.startsWith(hash));
    if (match) activate(match.dataset.src);
  }
</script>

</body>
</html>
