{#- index switcher: two framing rows, iframe-based -#}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ person.name }} — Resume variants</title>
<meta name="viewport" content="width=device-width,initial-scale=1">
<style>
  :root{
    --bg:#0b0d12; --panel:#13161e; --line:#252a36; --ink:#e8e9ed; --dim:#7b8294;
    --p1:#a855f7; --p2:#22d3ee; --teal:#0f766e;
    --sans:'Inter','Helvetica Neue',system-ui,sans-serif;
    --mono:ui-monospace,'SF Mono','JetBrains Mono',monospace;
  }
  *{box-sizing:border-box}
  html,body{margin:0;height:100%;background:var(--bg);color:var(--ink);font-family:var(--sans);font-size:13.5px}
  body{display:grid;grid-template-rows:auto 1fr}

  header{
    display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:18px;
    padding:10px 18px 12px;background:var(--panel);
    border-bottom:1px solid var(--line);
  }
  .brand{display:flex;align-items:baseline;gap:8px}
  .brand .name{font-weight:700;letter-spacing:-0.3px;font-size:15px}
  .brand .lbl{color:var(--dim);font-family:var(--mono);font-size:11px;letter-spacing:0.1em;text-transform:uppercase}

  .navs{display:flex;flex-direction:column;gap:6px}
  .nav-row{display:flex;align-items:center;gap:10px;flex-wrap:wrap}
  .nav-row .tag{
    font-family:var(--mono);font-size:10px;letter-spacing:0.14em;text-transform:uppercase;
    color:var(--dim);padding:2px 8px;border:1px solid var(--line);border-radius:99px;white-space:nowrap;
  }
  .nav-row.framing-blockchain .tag{color:#c084fc;border-color:rgba(192,132,252,0.35)}
  .nav-row.framing-platform   .tag{color:#5eead4;border-color:rgba(94,234,212,0.35)}

  nav{display:flex;gap:4px;flex-wrap:wrap}
  nav button{
    appearance:none;background:transparent;border:1px solid var(--line);color:var(--ink);
    padding:6px 12px;border-radius:999px;font-family:var(--sans);font-size:12px;font-weight:500;
    cursor:pointer;transition:all .15s;display:flex;align-items:center;gap:6px;
  }
  nav button:hover{border-color:var(--p2);color:var(--p2)}
  nav button.active{border-color:transparent;color:#fff;font-weight:600}
  .framing-blockchain nav button.active{background:linear-gradient(135deg,var(--p1),#ec4899)}
  .framing-platform   nav button.active{background:linear-gradient(135deg,var(--teal),var(--p2))}

  .actions{display:flex;gap:8px;align-items:center}
  .actions a{
    color:var(--dim);text-decoration:none;font-family:var(--mono);font-size:11.5px;
    padding:6px 12px;border:1px solid var(--line);border-radius:999px;transition:all .15s;white-space:nowrap;
  }
  .actions a:hover{color:var(--ink);border-color:var(--ink)}

  main{position:relative;background:#fff}
  iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:none}
  iframe.active{display:block}

  @media (max-width: 860px){
    header{grid-template-columns:1fr;gap:10px;padding:10px 12px}
    .actions{display:none}
  }
  @media (max-width: 520px){
    .brand .lbl{display:none}
    .nav-row{gap:6px}
    .nav-row .tag{font-size:9.5px;padding:2px 6px;letter-spacing:0.1em}
    nav{gap:3px}
    nav button{padding:5px 9px;font-size:11.5px}
  }
</style>
</head>
<body>

<header>
  <div class="brand">
    <span class="name">{{ person.name }}</span>
    <span class="lbl">resume.variants/</span>
  </div>

  <div class="navs">
    {% for framing_name, items in nav_groups.items() %}
    <div class="nav-row framing-{{ framing_name }}">
      <span class="tag">{{ framing_name }}</span>
      <nav class="tabs">
        {% for item in items %}<button data-src="{{ item.out }}?v={{ cache_bust }}"{% if loop.first and framing_name == default_framing %} class="active"{% endif %}>{{ item.label }}</button>
        {% endfor %}
      </nav>
    </div>
    {% endfor %}
  </div>

  <div class="actions">
    <a id="open-tab" href="{{ default_target }}" target="_blank" rel="noopener">↗ open in new tab</a>
  </div>
</header>

<main>
  {% for item in all_targets %}<iframe id="f-{{ item.out | replace('.html','') }}"{% if loop.first %} src="{{ item.out }}?v={{ cache_bust }}" class="active"{% else %} data-src="{{ item.out }}?v={{ cache_bust }}"{% endif %} title="{{ item.label }}"></iframe>
  {% endfor %}
</main>

<script>
  const allTabs = document.querySelectorAll('nav.tabs button');
  const frames = document.querySelectorAll('main iframe');
  const openTab = document.getElementById('open-tab');

  function activate(src) {
    allTabs.forEach(b => b.classList.toggle('active', b.dataset.src === src));
    frames.forEach(fr => {
      const want = (fr.id === 'f-' + src.replace('.html',''));
      if (want && !fr.src) fr.src = fr.dataset.src || src;
      fr.classList.toggle('active', want);
    });
    openTab.href = src;
    history.replaceState(null, '', '#' + src.replace('.html',''));
  }

  allTabs.forEach(b => b.addEventListener('click', () => activate(b.dataset.src)));

  window.addEventListener('keydown', e => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    const i = parseInt(e.key, 10);
    if (i >= 1 && i <= allTabs.length) {
      e.preventDefault();
      activate(allTabs[i-1].dataset.src);
    }
  });

  const hash = location.hash.replace('#','');
  if (hash) {
    const match = Array.from(allTabs).find(b => b.dataset.src.startsWith(hash));
    if (match) activate(match.dataset.src);
  }
</script>

</body>
</html>
